{
  "name": "sp-habits",
  "version": "0.23.1",
  "private": true,
  "type": "module",
  "description": "Habit goals and event limits for Super Productivity",
  "scripts": {
    "test": "node --test",
    "build": "node scripts/pack.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "lint": "eslint src scripts tests eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{js,css,html,json}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" eslint.config.js \".github/**/*.yml\"",
    "format": "prettier --write \"src/**/*.{js,css,html,json}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" eslint.config.js \".github/**/*.yml\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KingKord/sp-habits.git"
  },
  "homepage": "https://github.com/KingKord/sp-habits#readme",
  "bugs": {
    "url": "https://github.com/KingKord/sp-habits/issues"
  }
}
